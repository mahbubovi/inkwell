PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/inkwell
JWT_SECRET=replace-with-a-long-random-string
# Access token lifetime (short, so a stolen token expires quickly) and refresh-session length in days
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_DAYS=7
# Refresh cookie: "secure" is switched on automatically when NODE_ENV=production.
# If the frontend is on a different site than the API, use COOKIE_SAMESITE=none (requires HTTPS).
COOKIE_SAMESITE=lax
# Comma-separated origins allowed to call the API directly (the Vite dev server proxies /api, so this is for deployed setups)
CLIENT_URL=http://localhost:5173
